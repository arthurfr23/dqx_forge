{
  "datasets": [
    {
      "name": "ds_ultima_execucao",
      "displayName": "last_run",
      "queryLines": [
        "WITH ultima AS (\n",
        "  SELECT max(run_time) AS run_time FROM IDENTIFIER(CONCAT(:summary_catalog_name, '.', :summary_schema_name, '.', :summary_table_name))\n",
        "),\n",
        "metricas AS (\n",
        "  SELECT m.metric_name, CAST(m.metric_value AS DOUBLE) AS metric_value\n",
        "  FROM IDENTIFIER(CONCAT(:summary_catalog_name, '.', :summary_schema_name, '.', :summary_table_name)) m\n",
        "  JOIN ultima u ON m.run_time = u.run_time\n",
        "  WHERE m.metric_name IN ('input_row_count','error_row_count','warning_row_count','valid_row_count')\n",
        ")\n",
        "SELECT\n",
        "  SUM(CASE WHEN metric_name = 'input_row_count'   THEN metric_value ELSE 0 END) AS input_rows,\n",
        "  SUM(CASE WHEN metric_name = 'valid_row_count'   THEN metric_value ELSE 0 END) AS valid_rows,\n",
        "  SUM(CASE WHEN metric_name = 'error_row_count'   THEN metric_value ELSE 0 END) AS error_rows,\n",
        "  SUM(CASE WHEN metric_name = 'warning_row_count' THEN metric_value ELSE 0 END) AS warning_rows,\n",
        "  100 * try_divide(\n",
        "    SUM(CASE WHEN metric_name = 'error_row_count' THEN metric_value ELSE 0 END),\n",
        "    SUM(CASE WHEN metric_name = 'input_row_count' THEN metric_value ELSE 0 END)\n",
        "  ) AS error_pct,\n",
        "  (SELECT run_time FROM ultima) AS run_time\n",
        "FROM metricas\n"
      ],
      "parameters": [
        {
          "displayName": "summary_catalog_name",
          "keyword": "summary_catalog_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "main"
                }
              ]
            }
          }
        },
        {
          "displayName": "summary_schema_name",
          "keyword": "summary_schema_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "default"
                }
              ]
            }
          }
        },
        {
          "displayName": "summary_table_name",
          "keyword": "summary_table_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "dq_metrics"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_tendencia",
      "displayName": "quality_trend",
      "queryLines": [
        "WITH metricas AS (\n",
        "  SELECT run_time, run_id, metric_name, CAST(metric_value AS DOUBLE) AS metric_value\n",
        "  FROM IDENTIFIER(CONCAT(:summary_catalog_name, '.', :summary_schema_name, '.', :summary_table_name))\n",
        "  WHERE metric_name IN ('input_row_count','error_row_count','warning_row_count','valid_row_count')\n",
        "    AND run_time IS NOT NULL\n",
        ")\n",
        "SELECT\n",
        "  CAST(run_time AS TIMESTAMP) AS run_time,\n",
        "  SUM(CASE WHEN metric_name = 'input_row_count'   THEN metric_value ELSE 0 END) AS input_rows,\n",
        "  SUM(CASE WHEN metric_name = 'valid_row_count'   THEN metric_value ELSE 0 END) AS valid_rows,\n",
        "  SUM(CASE WHEN metric_name = 'error_row_count'   THEN metric_value ELSE 0 END) AS error_rows,\n",
        "  SUM(CASE WHEN metric_name = 'warning_row_count' THEN metric_value ELSE 0 END) AS warning_rows,\n",
        "  100 * try_divide(\n",
        "    SUM(CASE WHEN metric_name = 'error_row_count' THEN metric_value ELSE 0 END),\n",
        "    SUM(CASE WHEN metric_name = 'input_row_count' THEN metric_value ELSE 0 END)\n",
        "  ) AS error_pct\n",
        "FROM metricas\n",
        "GROUP BY run_time\n",
        "ORDER BY run_time\n"
      ],
      "parameters": [
        {
          "displayName": "summary_catalog_name",
          "keyword": "summary_catalog_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "main"
                }
              ]
            }
          }
        },
        {
          "displayName": "summary_schema_name",
          "keyword": "summary_schema_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "default"
                }
              ]
            }
          }
        },
        {
          "displayName": "summary_table_name",
          "keyword": "summary_table_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "dq_metrics"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_por_check",
      "displayName": "by_check",
      "queryLines": [
        "WITH erros AS (\n",
        "  SELECT 'Error' AS severity, e.name AS check_name, COUNT(*) AS rows_affected\n",
        "  FROM IDENTIFIER(CONCAT(:inv_catalog_name, '.', :inv_schema_name, '.', :q_table_name))\n",
        "  LATERAL VIEW EXPLODE(IDENTIFIER(:error_col_name)) exploded_errors AS e\n",
        "  GROUP BY e.name\n",
        "),\n",
        "avisos AS (\n",
        "  SELECT 'Warning' AS severity, w.name AS check_name, COUNT(*) AS rows_affected\n",
        "  FROM IDENTIFIER(CONCAT(:inv_catalog_name, '.', :inv_schema_name, '.', :q_table_name))\n",
        "  LATERAL VIEW EXPLODE(IDENTIFIER(:warn_col_name)) exploded_warnings AS w\n",
        "  GROUP BY w.name\n",
        "),\n",
        "juntos AS (SELECT * FROM erros UNION ALL SELECT * FROM avisos),\n",
        "total AS (SELECT SUM(rows_affected) AS todos FROM juntos)\n",
        "SELECT severity, check_name, rows_affected,\n",
        "       ROUND((rows_affected * 100.0) / NULLIF(total.todos, 0), 2) AS pct\n",
        "FROM juntos, total\n",
        "ORDER BY rows_affected DESC\n"
      ],
      "parameters": [
        {
          "displayName": "inv_catalog_name",
          "keyword": "inv_catalog_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "main"
                }
              ]
            }
          }
        },
        {
          "displayName": "inv_schema_name",
          "keyword": "inv_schema_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "default"
                }
              ]
            }
          }
        },
        {
          "displayName": "q_table_name",
          "keyword": "q_table_name",
          "dataType": "STRING",
          "complexType": "SCALAR",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
